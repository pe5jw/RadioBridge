<Window xmlns="https://github.com/avaloniaui/avalonia/xaml"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RadioBridge.MainWindow"
        Title="RadioBridge — Audio over netwerk v0.9"
        Width="680" Height="1020"
        MinWidth="560" MinHeight="800"
        Background="#1e1e1e"
        Foreground="#dcdcdc"
        FontFamily="Segoe UI, sans-serif"
        FontSize="13">

  <Window.Styles>
    <Style Selector="GroupBox">
      <Setter Property="Margin" Value="8,4"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="BorderBrush" Value="#444"/>
      <Setter Property="Foreground" Value="#aaa"/>
    </Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="Background" Value="#2d2d2d"/>
      <Setter Property="Foreground" Value="#dcdcdc"/>
      <Setter Property="BorderBrush" Value="#555"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#3c3c3c"/>
      <Setter Property="Foreground" Value="#dcdcdc"/>
      <Setter Property="BorderBrush" Value="#666"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="4,2"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#505050"/>
    </Style>
    <Style Selector="RadioButton, CheckBox">
      <Setter Property="Foreground" Value="#dcdcdc"/>
      <Setter Property="Margin" Value="4,2"/>
    </Style>
    <Style Selector="Label">
      <Setter Property="Foreground" Value="#aaa"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <StackPanel Margin="8" Spacing="4">

      <!-- ── Modus ── -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Modus" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal" Spacing="24">
            <RadioButton x:Name="RbServer" Content="Server  (wacht op verbinding)"
                         IsChecked="True" GroupName="Mode"
                         Checked="OnModeChanged"/>
            <RadioButton x:Name="RbClient" Content="Client  (maak verbinding)"
                         GroupName="Mode"
                         Checked="OnModeChanged"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Verbinding ── -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Verbinding" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
          <Grid ColumnDefinitions="130,*,80,100" RowDefinitions="Auto,Auto">
            <Label Grid.Row="0" Grid.Column="0" Content="IP-adres (client):"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtHost" Text="127.0.0.1"
                     IsEnabled="False"/>
            <Label Grid.Row="0" Grid.Column="2" Content="Poort:" Margin="8,0,0,0"/>
            <NumericUpDown Grid.Row="0" Grid.Column="3" x:Name="NudPort"
                           Minimum="1024" Maximum="65535" Value="5000"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ── Audio apparaten ── -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Audio apparaten" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
            <Label Grid.Row="0" Grid.Column="0" Content="Opname (mic):"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CbCapture" HorizontalAlignment="Stretch"/>
            <Label Grid.Row="1" Grid.Column="0" Content="Afspelen (spkr):" Margin="0,4,0,0"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbPlayback" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ── Codec / preset ── -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Codec / kwaliteit" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
          <ComboBox x:Name="CbPreset" HorizontalAlignment="Stretch"/>
          <TextBlock x:Name="TblPresetInfo" Text="" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <!-- ── Ruisonderdrukking ── -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Ruisonderdrukking" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <CheckBox x:Name="ChkNoise" Content="Ruisfilter inschakelen"
                      Checked="OnNoiseChanged" Unchecked="OnNoiseChanged"/>
            <TextBlock x:Name="TblNoiseMode" Text="" Foreground="#888" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ── Serieel poort 1 (CAT) ── -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Serieel poort 1  (CAT / transceiver control)" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
          <CheckBox x:Name="ChkPort1" Content="Inschakelen"
                    Checked="OnPort1Changed" Unchecked="OnPort1Changed"/>
          <Grid ColumnDefinitions="90,*,70,90,80,90" Margin="0,4,0,0" x:Name="GridPort1" IsEnabled="False">
            <Label Grid.Column="0" Content="COM poort:"/>
            <ComboBox Grid.Column="1" x:Name="CbPort1Com"/>
            <Label Grid.Column="2" Content="Baud:" Margin="8,0,0,0"/>
            <NumericUpDown Grid.Column="3" x:Name="NudPort1Baud" Minimum="300" Maximum="115200" Value="9600"/>
            <Label Grid.Column="4" Content="TCP:" Margin="8,0,0,0"/>
            <NumericUpDown Grid.Column="5" x:Name="NudPort1Tcp" Minimum="1024" Maximum="65535" Value="5001"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ── Serieel poort 2 (PTT) ── -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="8">
        <StackPanel>
          <TextBlock Text="Serieel poort 2  (PTT / keying)" Foreground="#aaa" FontSize="11" Margin="0,0,0,4"/>
          <CheckBox x:Name="ChkPort2" Content="Inschakelen"
                    Checked="OnPort2Changed" Unchecked="OnPort2Changed"/>
          <Grid ColumnDefinitions="90,*,70,90,80,90" Margin="0,4,0,0" x:Name="GridPort2" IsEnabled="False">
            <Label Grid.Column="0" Content="COM poort:"/>
            <ComboBox Grid.Column="1" x:Name="CbPort2Com"/>
            <Label Grid.Column="2" Content="Baud:" Margin="8,0,0,0"/>
            <NumericUpDown Grid.Column="3" x:Name="NudPort2Baud" Minimum="300" Maximum="115200" Value="9600"/>
            <Label Grid.Column="4" Content="TCP:" Margin="8,0,0,0"/>
            <NumericUpDown Grid.Column="5" x:Name="NudPort2Tcp" Minimum="1024" Maximum="65535" Value="5002"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ── Knoppen ── -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
        <Button x:Name="BtnConnect" Content="Verbinden" Width="120"
                Background="#1a6b1a" Foreground="White"
                Click="OnConnectClick"/>
        <Button x:Name="BtnRefresh" Content="↻  Apparaten" Width="120"
                Click="OnRefreshClick"/>
        <Button x:Name="BtnFirewall" Content="🔥  Firewall openen" Width="150"
                Click="OnFirewallClick"/>
      </StackPanel>

      <!-- ── Status balk ── -->
      <Border x:Name="PnlStatus" Background="#1a3a1a"
              BorderBrush="#2a6a2a" BorderThickness="1"
              CornerRadius="4" Padding="8,6" Margin="0,2">
        <TextBlock x:Name="TblStatus" Text="Gestopt" Foreground="#6fbf6f"/>
      </Border>

      <!-- ── Log ── -->
      <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4"
              Height="260" Margin="0,2">
        <ScrollViewer x:Name="LogScroller" HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="TblLog"
                     Foreground="#aaa"
                     FontFamily="Consolas, monospace"
                     FontSize="11"
                     Padding="6"
                     TextWrapping="Wrap"/>
        </ScrollViewer>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>
